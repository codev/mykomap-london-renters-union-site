{"aboutHtml":"<div class=\"about\"> <h3>London Renters Union - Hackney Property Licensing Map</h3> <p> A <a href=\"https://www.londonrentersunion.org/\">London Renters Union</a> project </p> <p> This map displays property licensing data for the London Borough of Hackney, as of November 2025 from Hackney Council's public licensing register. </p> <p> Licensing data on public registers is often out of date. Unlicensed properties are a major problem, please bear this in mind if using these maps for outreach. </p> <p> This site is powered by <a href=\"https://digitalcommons.coop/mykomaps/\">Mykomaps</a> which was created by the <a href=\"https://digitalcommons.coop/\">Digital Commons Co-operative</a>. </p> </div> ","attr_namespace":"","dataSources":[{"id":"hackney-licensing","label":"Hackney Licensing Data","type":"csv","url":"hackney.csv"}],"defaultLatLng":[51.545,-0.055],"defaultOpenSidebar":false,"dialogueSize":{"width":"35vw","height":"225px","descriptionRatio":2.5},"disableClusteringAtZoom":0,"doesDirectoryHaveColours":false,"elem_id":"map-app","fields":{"description":"value","address":"value","postcode":"value","licenceHolder":"value","licenceRef":"value","managingAgent":"value","licenceType":{"type":"vocab","uri":"lic:"}},"filterableFields":["licenceType"],"gitcommit":"91262c0","htmlTitle":"Hackney Property Licensing","language":"EN","languages":["EN"],"mapAttribution":"Map data &copy; <a href=\"http://openstreetmap.org\">OpenStreetMap</a> contributors, <a href=\"http://creativecommons.org/licenses/by-sa/2.0/\">CC-BY-SA</a> | Powered by <a href=\"https://www.geoapify.com/\">Geoapify</a>","maxZoomOnGroup":18,"maxZoomOnOne":18,"maxZoomOnSearch":18,"minZoom":2,"noLodCache":true,"mykoMapVersion":"3.1.4","searchedFields":["description","address","postcode","licenceHolder"],"servicesPath":"services/","showAboutPanel":true,"showDatasetsPanel":false,"showDirectoryPanel":true,"showSearchPanel":true,"sidebarButtonColour":"#39cccc","timestamp":"2026-02-19T19:19:04.053Z","var